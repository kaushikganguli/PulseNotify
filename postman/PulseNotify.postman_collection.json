{
  "info": {
    "name": "PulseNotify API - 13 Scenarios",
    "description": "Run registration/login first. Access token and alert IDs are stored as collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "alertId",
      "value": ""
    },
    {
      "key": "otherAlertId",
      "value": ""
    },
    {
      "key": "otherUserToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register user (public)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"pulse_alice\",\n  \"password\": \"securepass123\",\n  \"email\": \"alice@example.com\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created',()=>pm.response.to.have.status(201));",
              "const d=pm.response.json(); pm.collectionVariables.set('accessToken',d.access);",
              "pm.test('Default role user',()=>pm.expect(d.role).to.eql('user'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Duplicate registration returns 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"pulse_alice\",\n  \"password\": \"securepass123\",\n  \"email\": \"alice@example.com\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate rejected',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login valid credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"pulse_alice\",\n  \"password\": \"securepass123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds',()=>pm.response.to.have.status(200)); pm.collectionVariables.set('accessToken',pm.response.json().access);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Login invalid credentials returns 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"pulse_alice\",\n  \"password\": \"incorrect-password\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid credentials rejected',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Create alert",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/alerts/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "alerts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"threshold_price\": \"4500.00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created',()=>pm.response.to.have.status(201)); pm.collectionVariables.set('alertId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 List own alerts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/alerts/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "alerts"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List succeeds',()=>pm.response.to.have.status(200)); pm.test('Array response',()=>pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Register second user for cross-user isolation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"pulse_bob\",\n  \"password\": \"securepass123\",\n  \"email\": \"bob@example.com\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Second user created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('otherUserToken',pm.response.json().access);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Mock price known route",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/flights/price/?route=DEL-BOM",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "flights",
            "price"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Known route',()=>pm.response.to.have.status(200)); pm.test('Numeric price',()=>pm.expect(pm.response.json().price).to.be.a('number'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Mock price unknown route returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/flights/price/?route=XXX-YYY",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "flights",
            "price"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown route',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Admin summary forbidden for regular user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/summary/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "summary"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Forbidden for regular user',()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Deactivate own alert",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/alerts/{{alertId}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "alerts",
            "{{alertId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deactivated',()=>pm.response.to.have.status(200)); pm.test('Inactive status',()=>pm.expect(pm.response.json().status).to.eql('inactive'));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Cannot deactivate another user's alert",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{otherUserToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/alerts/{{alertId}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "alerts",
            "{{alertId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Not found',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Alerts require JWT",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/alerts/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "alerts"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unauthorized',()=>pm.expect(pm.response.code).to.be.oneOf([401,403]));"
            ]
          }
        }
      ]
    }
  ]
}